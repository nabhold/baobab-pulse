# Copy to .env for local development. Names and safe example values only —
# never commit a real .env file or real credentials (item 83).

PULSE_ENVIRONMENT=local
PULSE_LOG_LEVEL=INFO

PULSE_DATABASE_URL=postgresql://pulse:pulse@localhost:5432/baobab_pulse

PULSE_OBJECT_STORAGE_ENDPOINT=
PULSE_OBJECT_STORAGE_BUCKET=baobab-pulse-evidence
PULSE_OBJECT_STORAGE_ACCESS_KEY=
PULSE_OBJECT_STORAGE_SECRET_KEY=

PULSE_OTEL_EXPORTER_OTLP_ENDPOINT=
PULSE_OTEL_TRACES_ENABLED=false

# Optional — only needed once a real (non-mock) Haystack Generator is
# selected. The core test suite and reference pipeline never require these.
PULSE_OPENAI_API_KEY=
PULSE_ANTHROPIC_API_KEY=

PULSE_API_HOST=0.0.0.0
PULSE_API_PORT=8000
